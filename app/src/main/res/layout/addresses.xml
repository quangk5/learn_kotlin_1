<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F6FA" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/addressesBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="#302D36" android:textSize="32sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sổ địa chỉ" android:textColor="#24212B" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/addressesStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:textColor="#777480" android:textSize="14sp" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:id="@+id/addressesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/addressAddButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_margin="16dp" android:text="+ Thêm địa chỉ" android:textAllCaps="false" app:cornerRadius="14dp" />
</LinearLayout>
