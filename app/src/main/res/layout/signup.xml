<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.25"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:id="@+id/tittle_signup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/title_spacing"
                android:text="Đăng ký"
                android:textColor="#1E88E5"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txt_fullName_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:hint="Họ và tên"
                android:inputType="textPersonName|textCapWords"
                android:minHeight="56dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/txt_username_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:autofillHints="emailAddress"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:minHeight="56dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/txt_Password_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:autofillHints="newPassword"
                android:hint="Mật khẩu (ít nhất 6 ký tự)"
                android:inputType="textPassword"
                android:minHeight="56dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/txt_confirmPassword_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:autofillHints="newPassword"
                android:hint="Nhập lại mật khẩu"
                android:inputType="textPassword"
                android:minHeight="56dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="@dimen/button_min_height"
                android:text="Đăng ký" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
