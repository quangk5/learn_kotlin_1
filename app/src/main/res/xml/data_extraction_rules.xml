<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not restore tokens encrypted with a device-bound Keystore key. -->
        <exclude domain="sharedpref" path="auth_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
